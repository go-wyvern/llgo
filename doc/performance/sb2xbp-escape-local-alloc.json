  "metrics_test_main": "package convert\n\nimport (\n    \"fmt\"\n    \"os\"\n    \"runtime\"\n    \"testing\"\n    _ \"unsafe\"\n)\n\n//go:linkname startGCMeasurement C.GC_start_performance_measurement\nfunc startGCMeasurement()\n\n//go:linkname fullGCTime C.GC_get_full_gc_total_time\nfunc fullGCTime() uintptr\n\nfunc TestMain(m *testing.M) {\n    var before, after runtime.MemStats\n    startGCMeasurement()\n    runtime.ReadMemStats(&before)\n    code := m.Run()\n    runtime.ReadMemStats(&after)\n    fmt.Printf(\"NOSCAN_METRICS alloc_bytes=%d num_gc=%d gc_ms=%d\\n\", after.TotalAlloc-before.TotalAlloc, after.NumGC-before.NumGC, fullGCTime())\n    os.Exit(code)\n}\n",
